<?xml version="1.0" encoding="utf-8"?>
<!-- A champagne ring draws itself around the rupee mark, which settles into place. Stays inside the splash icon's 72-unit circle. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <path
                android:name="ring"
                android:pathData="M54,24a30,30 0 1,1 0,60a30,30 0 1,1 0,-60"
                android:strokeColor="@color/ic_launcher_mark"
                android:strokeWidth="1.2"
                android:strokeLineCap="round"
                android:trimPathEnd="0" />
            <group
                android:name="mark"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.7"
                android:scaleY="0.7">
                <group
                    android:scaleX="2.6"
                    android:scaleY="2.6"
                    android:translateX="22.8"
                    android:translateY="22.8">
                    <path
                        android:name="rupee"
                        android:fillAlpha="0"
                        android:fillColor="@color/ic_launcher_mark"
                        android:pathData="M13.66,7c-0.56,-1.18 -1.76,-2 -3.16,-2L6,5L6,3h12v2h-3.26c0.48,0.58 0.84,1.26 1.05,2L18,7v2h-2.02c-0.25,2.8 -2.61,5 -5.48,5h-1.28l6.28,7L13,21l-6.5,-7v-2h4c1.74,0 3.15,-1.21 3.47,-3L6,9L6,7h7.66z" />
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="ring">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="@integer/splash_icon_duration"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="rupee">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:startOffset="150"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="mark">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="@integer/splash_icon_duration"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="0.7"
                    android:valueTo="0.85" />
                <objectAnimator
                    android:duration="@integer/splash_icon_duration"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="0.7"
                    android:valueTo="0.85" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
