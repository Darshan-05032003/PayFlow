<?xml version="1.0" encoding="utf-8"?>
<!--
  Benchmark build type only: never merged into debug or release. Exported so the shell can reach it,
  and protected by DUMP, which the shell holds and normal apps cannot get.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".benchmark.SeedDataReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
