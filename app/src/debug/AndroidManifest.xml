<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only: a fake UPI app so the real-intent path (chooser sheet → upi://pay → activity result → response parsing) can be
  exercised end to end on an emulator that has no GPay / PhonePe. Merged into debug builds only; release has no such component.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".debugupi.SandboxUpiActivity"
            android:exported="true"
            android:label="@string/sandbox_upi_label"
            android:taskAffinity=""
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="upi" android:host="pay" />
            </intent-filter>
        </activity>
        <!-- Design catalog: every design-system component in every state. Sample values only. -->
        <activity
            android:name=".ui.designsystem.catalog.DesignCatalogActivity"
            android:exported="true"
            android:label="Design catalog"
            android:theme="@style/Theme.PayFlow" />
    </application>
</manifest>
